{
  "name": "growspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:rules": "tsx --test tests/firebase.test.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-growspace",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-growspace \"tsx --test tests/firebase.test.ts\"",
    "deploy:firebase": "firebase deploy --only hosting,firestore --project growspace-c516a"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^15.29.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  }
}
