rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
    function text(v, max) { return v is string && v.size() <= max; }
    function revision() {
      return request.resource.data.revision is int && request.resource.data.revision > 0
        && text(request.resource.data.lastMutationId, 100)
        && request.resource.data.lastMutationId.size() > 0
        && (resource == null ? request.resource.data.revision == 1 : request.resource.data.revision == resource.data.revision + 1);
    }
    function course(uid, data) {
      return text(data.courseId, 100) && (data.courseId == '' || exists(/databases/$(database)/documents/users/$(uid)/courses/$(data.courseId)));
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && revision()
        && request.resource.data.keys().hasOnly(['name','weeklyGoal','revision','lastMutationId'])
        && text(request.resource.data.name,100) && request.resource.data.name.size()>0
        && request.resource.data.weeklyGoal is int && request.resource.data.weeklyGoal>=1 && request.resource.data.weeklyGoal<=99;
      match /courses/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && revision()
          && request.resource.data.keys().hasOnly(['name','code','color','revision','lastMutationId'])
          && text(request.resource.data.name,200) && request.resource.data.name.size()>0
          && text(request.resource.data.code,50) && text(request.resource.data.color,100);
        allow delete: if owner(uid);
      }
      match /tasks/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && revision() && course(uid,request.resource.data)
          && request.resource.data.keys().hasOnly(['title','courseId','due','priority','done','completedAt','revision','lastMutationId'])
          && text(request.resource.data.title,500) && request.resource.data.title.size()>0
          && request.resource.data.due is string && request.resource.data.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.priority in ['high','medium','low'] && request.resource.data.done is bool
          && (request.resource.data.done ? request.resource.data.completedAt is string : request.resource.data.completedAt == null);
        allow delete: if owner(uid);
      }
      match /events/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && revision() && course(uid,request.resource.data)
          && request.resource.data.keys().hasOnly(['title','courseId','day','time','kind','revision','lastMutationId'])
          && text(request.resource.data.title,500) && request.resource.data.title.size()>0
          && request.resource.data.day in ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']
          && request.resource.data.time is string && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.kind in ['class','exam'];
        allow delete: if owner(uid);
      }
      match /books/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && revision()
          && request.resource.data.keys().hasOnly(['title','author','progress','status','note','revision','lastMutationId'])
          && text(request.resource.data.title,500) && request.resource.data.title.size()>0
          && text(request.resource.data.author,200) && text(request.resource.data.note,20000)
          && request.resource.data.progress is int && request.resource.data.progress>=0 && request.resource.data.progress<=100
          && request.resource.data.status in ['reading','planned','finished'];
        allow delete: if owner(uid);
      }
    }
  }
}
